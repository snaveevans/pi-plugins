{
  "name": "pi-goal-x",
  "version": "0.31.8",
  "private": true,
  "type": "module",
  "description": "Adds /goal to pi: conversational goal planning, flexible or ordered goals, persistent progress, and an independent completion auditor.",
  "bin": {
    "pi-goal-x-recover": "scripts/recover-session-checkpoints.mjs"
  },
  "keywords": ["pi-package", "pi", "pi-extension", "goal", "sisyphus", "autoresearch", "agent-loop", "long-running"],
  "license": "MIT",
  "pi": {
    "extensions": ["./extensions/index.ts"]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node scripts/run-unit-tests.mjs",
    "test:serial": "node --experimental-strip-types --test --test-concurrency=1 tests/*.test.ts",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "test:integration": "node scripts/run-unit-tests.mjs integration",
    "test:all": "node scripts/run-unit-tests.mjs all",
    "test:selfcheck": "node scripts/run-unit-tests.mjs --selfcheck",
    "test:e2e": "node scripts/run-unit-tests.mjs e2e",
    "test:checkpoint-recovery": "node --experimental-strip-types --test tests/session-checkpoint-growth.test.ts tests/session-checkpoint-recovery.test.ts tests/goal-session-health.test.ts",
    "test:settings-race": "node --experimental-strip-types --test tests/goal-settings-race.test.ts",
    "test:oracle": "node --experimental-strip-types --test tests/goal-oracle.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.83.0 <0.88.0",
    "@earendil-works/pi-coding-agent": ">=0.83.0 <0.88.0",
    "@earendil-works/pi-tui": ">=0.83.0 <0.88.0",
    "typebox": "^1.3.11"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.87.0",
    "@earendil-works/pi-coding-agent": "0.87.0",
    "@earendil-works/pi-tui": "0.87.0",
    "@eslint/js": "^9.39.5",
    "@xterm/headless": "^6.0.0",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "typebox": "^1.3.11",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0"
  },
  "overrides": {
    "@earendil-works/pi-coding-agent": {
      "undici": "8.10.0",
      "minimatch": "10.2.6"
    },
    "minimatch": {
      "brace-expansion": "5.0.9"
    }
  },
  "engines": {
    "node": ">=22.15.0"
  }
}
